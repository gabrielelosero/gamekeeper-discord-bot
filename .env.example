# Bot token (Discord Developer Portal > Applications > Bot > Reset Token)
DISCORD_TOKEN=

# Optional: test server ID, slash commands show up there instantly
GUILD_ID=

# ID of the channel where the welcome message is sent
WELCOME_CHANNEL_ID=

# Optional: welcome text, {user} = member mention, {server} = server name
WELCOME_MESSAGE=

# Minecraft server queried by /status
MC_HOST=
MC_PORT=25565
